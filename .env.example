# Google measurement
# Prefer GTM in production. Direct GA is a documented fallback when GTM is absent.
GTM_ID=GTM-XXXXXXX
# GA_TAG=G-XXXXXXXXXX

# Google PageSpeed Insights API (server-side only)
# Create a dedicated, restricted key in Google Cloud with only the PageSpeed Insights API enabled.
GOOGLE_PAGESPEED_API_KEY=YOUR_RESTRICTED_PAGESPEED_API_KEY

# Supabase (server-side chat persistence)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Google Chat app
GOOGLE_CHAT_SPACE=spaces/SPACE_ID
# Store the complete one-line JSON value in your hosting provider's encrypted
# environment variables. Never commit the downloaded service-account key.
GOOGLE_CHAT_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key_id":"REDACTED","private_key":"REDACTED","client_email":"YOUR_SERVICE_ACCOUNT_EMAIL"}
# Alternative to GOOGLE_CHAT_SERVICE_ACCOUNT_JSON:
# GOOGLE_CHAT_CLIENT_EMAIL=chat-app@YOUR_PROJECT_ID.iam.gserviceaccount.com
# GOOGLE_CHAT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREDACTED\n-----END PRIVATE KEY-----\n"

# Used in the Chat API HTTP endpoint URL:
# https://YOUR_DOMAIN/api/chat/inbound?secret=THE_SAME_RANDOM_VALUE
GOOGLE_CHAT_INBOUND_SECRET=GENERATE_A_LONG_RANDOM_VALUE

# Optional outbound-only fallback. It cannot read replies.
# GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=REDACTED&token=REDACTED

# Business email (separate from Google Chat service-account authorization)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@YOUR_DOMAIN
SMTP_PASS=YOUR_GOOGLE_APP_PASSWORD
SMTP_FROM_EMAIL=support@YOUR_DOMAIN
SMTP_FROM_NAME=Crib Network
CHAT_FORWARD_EMAIL=support@YOUR_DOMAIN
CONTACT_EMAIL=support@YOUR_DOMAIN
