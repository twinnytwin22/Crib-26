{
  "name": "CRIB Google Chat Reply Bridge",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "crib-google-chat-reply",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "google-chat-webhook",
      "name": "Google Chat Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "crib-google-chat-reply"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst message = body.message ?? body.chat?.messagePayload?.message ?? {};\nconst space = body.space ?? body.chat?.messagePayload?.space ?? body.chat?.space ?? {};\nconst text = typeof message.text === 'string' ? message.text.trim() : '';\nconst senderType = message.sender?.type ?? '';\nconst threadName = message.thread?.name ?? null;\nconst threadKey = message.thread?.threadKey ?? body.message?.threadKey ?? null;\nconst messageName = message.name ?? null;\n\nreturn [{ json: {\n  raw: body,\n  type: body.type ?? null,\n  text,\n  senderType,\n  threadName,\n  threadKey,\n  messageName,\n  spaceName: space.name ?? null,\n  shouldForward: body.type === 'MESSAGE' && Boolean(text) && senderType !== 'BOT' && Boolean(threadName || threadKey)\n} }];"
      },
      "id": "normalize-event",
      "name": "Normalize Google Chat Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.shouldForward }}",
              "operation": "true"
            }
          ]
        }
      },
      "id": "only-human-thread-replies",
      "name": "Only Human Thread Replies",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://cribnetwork.io/api/chat/inbound",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { type: 'MESSAGE', message: { name: $json.messageName, text: $json.text, thread: { name: $json.threadName, threadKey: $json.threadKey }, sender: $json.raw.message?.sender ?? $json.raw.chat?.messagePayload?.message?.sender }, space: { name: $json.spaceName } } }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 10000
        }
      },
      "id": "forward-to-crib",
      "name": "Forward Reply to CRIB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 220]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.type === 'ADDED_TO_SPACE' ? { text: 'CRIB Support connected.' } : { success: true } }}",
        "options": {}
      },
      "id": "respond-google-chat",
      "name": "Respond to Google Chat",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1200, 300]
    }
  ],
  "connections": {
    "Google Chat Event": { "main": [[{ "node": "Normalize Google Chat Event", "type": "main", "index": 0 }]] },
    "Normalize Google Chat Event": { "main": [[{ "node": "Only Human Thread Replies", "type": "main", "index": 0 }]] },
    "Only Human Thread Replies": { "main": [[{ "node": "Forward Reply to CRIB", "type": "main", "index": 0 }], [{ "node": "Respond to Google Chat", "type": "main", "index": 0 }]] },
    "Forward Reply to CRIB": { "main": [[{ "node": "Respond to Google Chat", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "crib-google-chat-reply-bridge-v1",
  "meta": { "templateCredsSetupCompleted": true },
  "tags": []
}
